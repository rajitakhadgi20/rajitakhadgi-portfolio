# Server
PORT=4000
# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Admin account seeded by `npm run seed` (change the password after first login isn't
# supported yet — for now just re-run the seed script with a new password, or edit
# the DB directly)
ADMIN_EMAIL=rajitashahi5@gmail.com
ADMIN_PASSWORD=12345678
ADMIN_NAME=Rajita Khadgi

# Outgoing email for the contact form (optional). If left blank, contact messages are
# still saved to the database and visible in the admin dashboard, they just won't be
# emailed to you. Works with Gmail (use an App Password), or any SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=rajita@example.com
